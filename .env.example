# traj-lens configuration — copy to .env and edit

# LLM provider for annotation (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_PROXY=none
LLM_RPS=20
LLM_MAX_CONCURRENCY=100

# Storage paths — all CLI commands and the API server read from here
TRAJLENS_DB=trajlens.db
TRAJLENS_BLOBS=blobs
